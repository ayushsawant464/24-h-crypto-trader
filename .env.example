# Active Environment Mode: 'test' (safe default) or 'prod' (competition)
BOT_MODE=test

# 1. Testing Account Credentials (Sandbox / Test Bot)
ROOSTOO_TEST_API_KEY=YOUR_TEST_API_KEY
ROOSTOO_TEST_SECRET_KEY=YOUR_TEST_SECRET_KEY

# 2. Production / Main Account Credentials (Official Competition Bot)
ROOSTOO_PROD_API_KEY=YOUR_PROD_API_KEY
ROOSTOO_PROD_SECRET_KEY=YOUR_PROD_SECRET_KEY

# Exchange URL
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Timing
REBALANCE_INTERVAL_HOURS=8
RISK_CHECK_INTERVAL_SECONDS=60
